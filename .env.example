# ---- Backend (codex-image-studio) ----
IMAGE_GEN_PORT=8088
IMAGE_GEN_MAX_CONCURRENCY=9
IMAGE_GEN_JOB_TIMEOUT_SECONDS=1800
IMAGE_GEN_CORS_ORIGIN=*
# 可选：让 Codex 登录、状态检查与生图请求统一使用指定出口代理。
# 支持 http://、https://、socks5://、socks5h://，也支持 URL 内的用户名和密码。
# IMAGE_GEN_PROXY_URL=http://proxy.example.com:7890
# IMAGE_GEN_NO_PROXY=127.0.0.1,localhost,codex-image-studio,image-gen-service,codex-image-studio-mcp,image-gen-mcp
# Windows 原生运行时可按需覆盖：
# IMAGE_GEN_CODEX_BIN=C:\Users\you\AppData\Roaming\npm\codex.cmd
# IMAGE_GEN_CODEX_HOME=C:\Users\you\.codex
# IMAGE_GEN_DEFAULT_WORKDIR=D:\Projects

# ---- MCP adapter (codex-image-studio-mcp) ----
IMAGE_GEN_MCP_PUBLISH_PORT=18089
IMAGE_GEN_MCP_GENERATION_TIMEOUT_SECONDS=1800
IMAGE_GEN_MCP_MAX_INLINE_IMAGES=8
IMAGE_GEN_MCP_MEDIA_BASE_URL=
IMAGE_GEN_MCP_MEDIA_TTL_SECONDS=3600
IMAGE_GEN_MCP_MEDIA_MAX_ITEMS=100
IMAGE_GEN_MCP_MEDIA_MAX_TOTAL_BYTES=209715200
IMAGE_GEN_MCP_ENABLE_CANCEL_TOOLS=false

# ---- Runtime volume overrides (optional) ----
# HOST_DATA_DIR=./runtime/data
# HOST_WORKDIR=./runtime/workspace
# HOST_CODEX_HOME=./runtime/codex-home
# HOST_IMAGES_DIR=./runtime/codex-home/generated_images
