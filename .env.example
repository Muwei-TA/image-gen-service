# ---- Backend (image-gen-service) ----
IMAGE_GEN_PORT=8088
IMAGE_GEN_MAX_CONCURRENCY=50
IMAGE_GEN_JOB_TIMEOUT_SECONDS=1800
IMAGE_GEN_CORS_ORIGIN=*

# ---- MCP adapter (image-gen-mcp) ----
IMAGE_GEN_MCP_PUBLISH_PORT=18089
IMAGE_GEN_MCP_GENERATION_TIMEOUT_SECONDS=1800
IMAGE_GEN_MCP_MAX_INLINE_IMAGES=8
IMAGE_GEN_MCP_ENABLE_CANCEL_TOOLS=false

# ---- Runtime volume overrides (optional) ----
# HOST_DATA_DIR=./runtime/data
# HOST_WORKDIR=./runtime/workspace
# HOST_CODEX_HOME=./runtime/codex-home
# HOST_IMAGES_DIR=./runtime/codex-home/generated_images
